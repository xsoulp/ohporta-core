[Unit]
Description=Minimal SwitchBot HTTP API
Wants=bluetooth.service
After=bluetooth.service

[Service]
Type=simple
Environment=PATH=%h/ohporta-core/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/ohporta-core/.venv/bin/python %h/ohporta-core/ohporta-server.py --host 0.0.0.0 --port 8765
WorkingDirectory=%h/ohporta-core
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
